# Copy to apps/api/.env on the server and fill in. Never commit the real .env.

NODE_ENV=production

# Required in production. Generate with: openssl rand -hex 48
JWT_SECRET=

# Port the API listens on. Nginx forwards your domain to it.
PORT=4100
# 127.0.0.1 keeps the API reachable only through Nginx. Use 0.0.0.0 to expose it directly.
HOST=127.0.0.1

# Where the SQLite database file lives. Back this file up.
# Tijar administrators (comma-separated emails): they see every account and set plans
PLATFORM_ADMINS=
# Shown on the Plan screen for upgrades: a phone number or an email
SALES_CONTACT=
# Optional server-wide Claude key for accounts without their own AI key (AI_MODEL defaults to claude-opus-5-5)
ANTHROPIC_API_KEY=
AI_MODEL=
DB_PATH=/var/www/kaarobarly/data/kaarobarly.db

# Optional
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
