{
  "expo": {
    "name": "Tijar",
    "slug": "kaarobarly",
    "version": "2.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "kaarobarly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zhtrader.kaarobarly",
      "icon": "./assets/images/icon.png",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zhtrader.kaarobarly",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0C2433",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C2433",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tijar uses your photos to attach payment proofs, logos and receipts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tijar uses Face ID to unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tijar uses the camera to scan barcodes on products.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#19B892",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {}
  }
}
